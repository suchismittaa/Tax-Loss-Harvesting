@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap");

:root {
  --bg: #0a0c12;
  --surface: #12151d;
  --surface-border: #232734;
  --ink: #eef0f5;
  --ink-dim: #8b90a3;
  --profit: #35d0a0;
  --loss: #ff6b6b;
  --amber: #ffb648;

  --pre-bg-1: #14171f;
  --pre-bg-2: #1b1f2b;
  --post-bg-1: #14285f;
  --post-bg-2: #1d3ea8;
  --post-accent: #6fa8ff;
  --font-display: "Space Grotesk", sans-serif;
  --font-body: "Inter", sans-serif;
  --font-mono: "IBM Plex Mono", monospace;

  --radius: 16px;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
}

.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.app {
  min-height: 100vh;
  background:
    radial-gradient(ellipse 900px 500px at 15% -10%, rgba(53, 208, 160, 0.08), transparent),
    radial-gradient(ellipse 900px 500px at 85% 0%, rgba(111, 168, 255, 0.10), transparent),
    var(--bg);
}

.app__header {
  padding: 28px 32px 8px;
  max-width: 1180px;
  margin: 0 auto;
}

.app__brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.app__brand-mark {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.06em;
  background: linear-gradient(135deg, var(--profit), var(--post-accent));
  color: #06090f;
  padding: 8px 10px;
  border-radius: 10px;
}

.app__brand-title {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  margin: 0;
  letter-spacing: -0.01em;
}

.app__brand-subtitle {
  margin: 2px 0 0;
  font-size: 13px;
  color: var(--ink-dim);
}

.app__main {
  max-width: 1180px;
  margin: 0 auto;
  padding: 20px 32px 64px;
}

/* ---------- Loader / Error ---------- */

.loader {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 120px 0;
  color: var(--ink-dim);
}

.loader__ring {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 3px solid var(--surface-border);
  border-top-color: var(--profit);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 100px 20px;
  color: var(--loss);
  text-align: center;
}

.error-state__retry {
  font-family: var(--font-body);
  font-weight: 600;
  padding: 10px 20px;
  border-radius: 10px;
  border: 1px solid var(--surface-border);
  background: var(--surface);
  color: var(--ink);
  cursor: pointer;
}

.error-state__retry:hover {
  border-color: var(--profit);
}

/* ---------- Cards ---------- */

.cards-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 28px;
}

.gains-card {
  border-radius: var(--radius);
  padding: 24px 24px 20px;
  border: 1px solid var(--surface-border);
}

.gains-card--pre {
  background: linear-gradient(160deg, var(--pre-bg-2), var(--pre-bg-1));
}

.gains-card--post {
  background: linear-gradient(160deg, var(--post-bg-2), var(--post-bg-1));
  border-color: rgba(111, 168, 255, 0.35);
}

.gains-card__header {
  margin-bottom: 18px;
}

.gains-card__eyebrow {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-dim);
  margin-bottom: 4px;
}

.gains-card--post .gains-card__eyebrow {
  color: var(--post-accent);
}

.gains-card__title {
  font-family: var(--font-display);
  font-size: 20px;
  margin: 0;
}

.gains-card__row {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr 1fr;
  align-items: center;
  padding: 10px 0;
  font-size: 13.5px;
}

.gains-card__row--head {
  color: var(--ink-dim);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 10px;
}

.gains-card__row:not(.gains-card__row--head) {
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.gains-card__label {
  color: var(--ink);
  font-weight: 500;
}

.gains-card__value--profit {
  color: var(--profit);
}

.gains-card__value--loss {
  color: var(--loss);
}

.gains-card__realised {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-weight: 600;
}

.gains-card__realised-value {
  font-size: 17px;
}

.gains-card__savings {
  margin-top: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 182, 72, 0.14);
  border: 1px solid rgba(255, 182, 72, 0.4);
  color: var(--amber);
  font-size: 13px;
  font-weight: 600;
  padding: 10px 14px;
  border-radius: 10px;
}

.gains-card__savings-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--amber);
  box-shadow: 0 0 0 4px rgba(255, 182, 72, 0.2);
}

/* ---------- Holdings table ---------- */

.holdings {
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius);
  padding: 20px;
}

.holdings__header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14px;
}

.holdings__title {
  font-family: var(--font-display);
  font-size: 18px;
  margin: 0;
}

.holdings__count {
  font-size: 12.5px;
  color: var(--ink-dim);
}

.holdings__scroll {
  overflow-x: auto;
}

.holdings-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

.holdings-table thead th {
  text-align: left;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ink-dim);
  font-weight: 500;
  padding: 0 10px 10px;
  border-bottom: 1px solid var(--surface-border);
  white-space: nowrap;
}

.holdings-table tbody td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 13px;
  vertical-align: middle;
}

.holdings-table tbody tr.is-selected {
  background: rgba(53, 208, 160, 0.06);
}

.holdings-table__checkbox-cell {
  width: 36px;
}

.holdings-table__checkbox-cell input {
  width: 16px;
  height: 16px;
  accent-color: var(--profit);
  cursor: pointer;
}

.holdings-table__asset {
  display: flex;
  align-items: center;
  gap: 10px;
}

.holdings-table__logo {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #1c202b;
  flex-shrink: 0;
}

.holdings-table__asset-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.holdings-table__symbol {
  font-weight: 600;
  font-size: 13.5px;
}

.holdings-table__name {
  font-size: 11.5px;
  color: var(--ink-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220px;
}

.holdings-table__stacked {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.holdings-table__muted {
  color: var(--ink-dim);
}

.holdings-table__gain {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.holdings-table__gain-value.is-profit {
  color: var(--profit);
}

.holdings-table__gain-value.is-loss {
  color: var(--loss);
}

.holdings-table__gain-balance {
  font-size: 11px;
  color: var(--ink-dim);
}

.holdings__view-all {
  margin-top: 16px;
  width: 100%;
  padding: 10px;
  border-radius: 10px;
  border: 1px dashed var(--surface-border);
  background: transparent;
  color: var(--ink-dim);
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 13px;
  cursor: pointer;
}

.holdings__view-all:hover {
  color: var(--ink);
  border-color: var(--profit);
}

/* ---------- Responsive ---------- */

@media (max-width: 860px) {
  .cards-row {
    grid-template-columns: 1fr;
  }

  .app__header,
  .app__main {
    padding-left: 16px;
    padding-right: 16px;
  }

  .gains-card__row {
    font-size: 12.5px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .loader__ring {
    animation: none;
  }
}
